// A single Postgres database, used identically for local development and
// production - no SQLite, no separate pooled/direct URLs. See
// THE LEX CONCEPT project for why this is the deliberate choice here too.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

// A portfolio piece. `type` is the top-level filter on the public site:
// "dev" | "design" | "data". `subCategory` only applies to type "design"
// (one of CATEGORY_VALUES in src/lib/categories.js) and powers the second
// row of filter buttons that appears when "Graphic Design" is selected.
// `techStack` and `liveUrl`/`githubUrl` are mainly used by "dev" and
// "data" works (tech tags + live demo / repo links, like the reference
// site); `images` holds extra screenshots/mockups shown in the gallery
// for any type.
model Work {
  id          Int      @id @default(autoincrement())
  title       String
  type        String // dev | design | data
  subCategory String? // design sub-category, only when type = "design"
  description String?
  techStack   String? // comma-separated tags, e.g. "Next.js,Prisma,PostgreSQL"
  liveUrl     String?
  githubUrl   String?
  imageUrl    String
  thumbUrl    String
  blurDataUrl String?
  status      String   @default("live") // live | draft
  views       Int      @default(0)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  // Optional case-study breakdown shown in the lightbox under the
  // description - any of the three may be left empty, in which case that
  // row (or the whole block, if all three are empty) is simply omitted.
  problem     String?
  approach    String?
  result      String?
  // Honest labelling shown on the card and in the lightbox:
  // "client" | "personal" | "concept" | "" (none). For "concept" work a
  // short not-affiliated notice is shown; `kindNote` overrides its wording.
  kind        String   @default("")
  kindNote    String?
  // One optional extra link with its own label, e.g. "Watch demo" or
  // "Download workbook".
  extraUrl    String?
  extraLabel  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  images      WorkImage[]

  @@index([status, type])
  @@index([createdAt])
}

model WorkImage {
  id          Int      @id @default(autoincrement())
  workId      Int
  work        Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  imageUrl    String
  blurDataUrl String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([workId])
}

// A labeled skill under a category (Languages, Frameworks, Design Tools,
// Data Tools, etc.) - admin can add/reorder/remove these freely, no fixed
// schema for what categories exist.
model Skill {
  id       Int    @id @default(autoincrement())
  category String // e.g. "Languages", "Frameworks", "Design Tools", "Data & Analytics"
  name     String
  order    Int    @default(0)
}

// One row (id: 1) holding every editable piece of text on the public
// site's Hero, About, Contact sections.
model SiteContent {
  id Int @id @default(1)

  heroName        String @default("Fasinu David Omotayo")
  heroRoles       String @default("Software Developer,Data Analyst,Graphic Designer") // used for SEO and the assistant; the hero shows heroHeadline
  heroHeadline    String @default("Software developer, data analyst and designer based in Lagos.")
  heroTagline     String @default("I build, design, and make sense of things.")
  heroSubtext     String @default("I build responsive web products, design brand identities, and turn raw data into clear decisions. Open to entry-level and remote roles.")
  // Legacy numeric stats (no longer shown; kept so old data is not dropped).
  heroStatProjects Int   @default(20)
  heroStatYears    Int   @default(2)
  heroStatClients  Int   @default(10)
  // The four stat tiles under the hero: a big value and a small label each.
  heroStat1Num    String @default("First Class")
  heroStat1Label  String @default("Honours, Computer Science")
  heroStat2Num    String @default("6 months")
  heroStat2Label  String @default("at a working print press")
  heroStat3Num    String @default("5")
  heroStat3Label  String @default("selected projects")
  heroStat4Num    String @default("3")
  heroStat4Label  String @default("disciplines, one standard")
  cvUrl           String? // link to a hosted CV/resume PDF; the hero's "Download CV" button is hidden when this is empty
  logoUrl         String? // uploaded logo image shown in the nav; falls back to an initials monogram when empty
  heroPhotoUrl    String? // uploaded hero portrait photo; falls back to an inline illustration when empty
  heroPhotoBlurDataUrl String?

  aboutHeadingLine1 String @default("The short version:")
  aboutHeadingLine2 String @default("builder, designer, analyst.")
  aboutParagraph1   String @default("I am Fasinu David Omotayo, a software developer, data analyst and designer based in Lagos. I graduated with First Class Honours in Computer Science, and I enjoy work where code, data and design meet.")
  aboutParagraph2   String @default("I completed a six-month internship at a working print press, which taught me to deliver to a brief and a deadline. I am also training in cybersecurity, and it shapes how I build: access is protected and data is handled with care.")
  aboutParagraph3   String @default("I am looking for entry-level and remote roles in web development or data analysis, where I can keep learning and ship useful work.")
  aboutImageUrl         String?
  aboutImageBlurDataUrl String?
  aboutArtImageUrl         String?
  aboutArtImageBlurDataUrl String?

  contactHeadingLine1 String @default("Let's work")
  contactHeadingLine2 String @default("together.")
  contactSubtext      String @default("Open to software, design, and data projects. Fill out the form or reach out directly.")
  contactEmail        String @default("hello@fasinudavid.com")

  githubUrl    String?
  linkedinUrl  String?
  instagramUrl String?
  twitterUrl   String?
  whatsappUrl  String? // stored as digits-only (country code + number), see /api/content

  updatedAt DateTime @updatedAt
}

// A client/collaborator quote shown in the Testimonials section - admin can
// add/edit/reorder/remove these freely, same simple pattern as Skill.
model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  quote     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  projectType String
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Activity {
  id        Int      @id @default(autoincrement())
  type      String // page_view | filter_click | upload | edit | delete | login | message
  message   String
  meta      String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}